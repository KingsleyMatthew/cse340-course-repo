<%- include('partials/header') %>
    <main id="main-content">
        <section class="page-intro">
            <h1><%= categoryDetails.name %></h1>
            <p>Service projects in this category:</p>
        </section>

        <ul class="project-list">
            <% projects.forEach(project => { %>
                <% const formattedDate = new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }); %>
                <li class="project-card">
                    <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                    <p><%= formattedDate %></p>
                    <p><%= project.description %></p>
                    <p class="project-location">Location: <%= project.location %></p>
                </li>
            <% }); %>
        </ul>

        <p><a href="/categories">Back to all categories</a></p>
    </main>
<%- include('partials/footer') %>
