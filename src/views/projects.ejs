<%- include('partials/header') %>
    <main id="main-content">
        <section class="page-intro">
            <h1><%= title %></h1>
            <h2>Upcoming Service Projects</h2>
        </section>
        <ul class="project-list">
            <% projects.forEach(project => { %>
                <% const formattedDate = new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }); %>
                <li class="project-card">
                    <h3><%= formattedDate %>: <a href="/project/<%= project.project_id %>"><%= project.title %></a> (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)</h3>
                    <p><%= project.description %></p>
                    <p class="project-location">Location: <%= project.location %></p>
                </li>
            <% }); %>
        </ul>
        <p><a href="/new-project">Add a new service project</a></p>
    </main>
<%- include('partials/footer') %>