<%- include('partials/header') %>
    <main id="main-content">
        <section class="page-intro">
            <h1><%= title %></h1>
            <h2>Upcoming Service Projects</h2>
        </section>
        <ul class="project-list">
            <% projects.forEach(project => { %>
                <% const formattedDate = new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }); %>
                <li class="project-card">
                    <h3><%= formattedDate %>: <%= project.title %> (<%= project.organization_name %>)</h3>
                    <p><%= project.description %></p>
                    <p class="project-location">Location: <%= project.location %></p>
                </li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>